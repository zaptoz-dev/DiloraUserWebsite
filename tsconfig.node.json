{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    /* Composite projects must emit. Without an outDir the emitted
       vite.config.js lands beside vite.config.ts and *shadows* it — Vite
       resolves .js before .ts — so every build would silently run a stale
       config. Park the output out of the way instead. */
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
