# ---------------------------------------------------------------------------
# Bolna credentials — server-side only, never exposed to the browser.
#
# These are read by server/index.js. Nothing here is bundled into the frontend:
# the browser only ever calls our own /api/demo-call. Do NOT prefix any of these
# with VITE_, which would inline them into the public JS bundle.
# ---------------------------------------------------------------------------
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_dilora_agent_id_here

# Optional. Omit entirely to let Bolna use the account's default outbound
# number. If set, it's passed as `from_phone_number` on each demo call.
BOLNA_FROM_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Bind to loopback only — Caddy/nginx is the public listener in front of it.
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Demo-call abuse limits
#
# /api/demo-call is public and dials whatever number a visitor types, so it is
# rate limited on three axes at once. Tune here; all are per rolling window.
# ---------------------------------------------------------------------------
DEMO_MAX_PER_IP_PER_HOUR=3
DEMO_MAX_PER_IP_PER_DAY=10
# One call per number per hour stops the form being used to pester a stranger.
DEMO_MAX_PER_NUMBER_PER_HOUR=1
DEMO_MAX_PER_NUMBER_PER_DAY=3
# Ceiling for the whole endpoint, so a bad day can't drain the Bolna balance.
DEMO_MAX_GLOBAL_PER_DAY=100

# ---------------------------------------------------------------------------
# CORS — only needed if the site is served from a DIFFERENT host than this API
# (e.g. the GitHub Pages mirror). Leave blank for the normal same-origin setup.
# Comma-separated exact origins. Never set this to "*".
# ---------------------------------------------------------------------------
DEMO_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Interactive voice demo (the "See Audeora in Your Industry" section)
#
# Powers WS /api/voice/stream: the visitor talks to an AI agent in the browser.
# Completely separate from the Bolna demo-call above — different vendors,
# different failure modes, no shared state.
#
# Pipeline: Deepgram STT -> Bedrock (Claude Haiku 4.5) -> Murf or Polly TTS.
# As with Bolna, never prefix any of these with VITE_ — that would inline the
# credential into the public JS bundle.
# ---------------------------------------------------------------------------

# --- Speech to text: Deepgram ---
# nova-3 deliberately. Measured on this account: nova-2 mostly fine but spiked
# to 11-13s at random, and the whisper-* models timed out entirely.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# --- LLM: AWS Bedrock ---
# Haiku 4.5 over Sonnet on purpose: replies are capped at 1-2 sentences, so
# Sonnet's extra quality has little to act on while costing hundreds of ms a
# turn. In a conversation, latency *is* quality.
#
# Region matters more than the model. Measured for an identical request:
#   ap-south-1  1139ms      us-east-1  1649ms
# Polly shows the same gap even wider (198ms vs 871ms to first byte), so keep
# both in ap-south-1 unless the box moves.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Text to speech ---
# "auto" walks VOICE_TTS_CHAIN in order and uses the first provider that
# answers, latching a failing one off for 5 minutes so a dead vendor is not
# retried every turn. Naming a single provider ("sarvam" / "polly" / "murf")
# pins it and disables fallback, so a misconfiguration is loud.
VOICE_TTS_PROVIDER=auto
VOICE_TTS_CHAIN=sarvam,polly,murf

# Measured time-to-first-byte, so the ordering cost is explicit:
#   Polly  Kajal       ~200ms
#   Sarvam bulbul:v3   ~429ms   (streaming, linear16)
#   Murf   falcon-2    ~130-300ms, but currently HTTP 402 "characters consumed"
# Sarvam leads despite being ~230ms slower than Polly: its Indian voices suit an
# India-facing demo, and it is the account with credit. For raw speed instead,
# set VOICE_TTS_PROVIDER=polly.

# --- Sarvam AI (primary voice) ---
# NOTE: only model bulbul:v3 is accepted, and `pitch`/`loudness` must never be
# sent — v3 rejects both. bulbul:v3 also rejects a good number of the speakers
# Sarvam's own docs list, so test any speaker before using it. Verified working
# on this account: priya, neha, kavya, pooja, simran, ritu, amit, rahul, rohan,
# aditya. Each persona picks its own (see server/voice/personas.js); this is the
# fallback when one doesn't.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_SPEAKER=priya
# en-IN keeps Indian names, places and rupee amounts sounding right, and handles
# Hinglish in Latin script acceptably. hi-IN for Devanagari input.
SARVAM_LANGUAGE=en-IN

# --- Amazon Polly (fallback) ---
# Rides on the AWS credentials Bedrock already needs, so it cannot separately run
# out of quota — which is exactly why it is the safety net.
# Kajal is en-IN neural, a better fit than the product's en-US Joanna.
# NOTE: Polly's `pcm` output accepts only 8000 or 16000 Hz. 24000 raises
# InvalidSampleRateException, which is why the pipeline runs at 16 kHz.
POLLY_REGION=ap-south-1
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=neural

# --- Murf (last; integration intact, resumes automatically on top-up) ---
MURF_API_KEY=your_murf_api_key_here
MURF_VOICE_ID=en-US-natalie
# falcon-2 is the only model the streaming endpoint accepts.
MURF_MODEL=falcon-2

# ---------------------------------------------------------------------------
# Voice demo abuse limits
#
# This endpoint spends Deepgram, Polly and Bedrock credits per session and has
# no authentication in front of it — it serves anonymous visitors, so it cannot.
# These four controls stand in for auth. Loosening them turns the endpoint into
# an open API billed to us.
# ---------------------------------------------------------------------------
VOICE_DEMO_ENABLED=true
VOICE_MAX_PER_IP_PER_HOUR=3
VOICE_MAX_CONCURRENT=5
VOICE_MAX_SESSION_SECONDS=90
# Hang up on an abandoned tab rather than paying to listen to an empty room.
VOICE_HANGUP_SILENCE_SEC=20
VOICE_MAX_TURNS=25

# Exact-match origin allowlist. Blank means same-origin only, which is the
# normal deployment. Comma-separated exact origins. Never set this to "*".
VOICE_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Voice tuning — override only with a measurement in hand. Defaults are in
# server/voice/config.js, each with the reasoning next to it.
# ---------------------------------------------------------------------------
# How long a pause ends the caller's turn. The product uses 950ms to absorb
# telephony jitter; browser audio has none, so 650ms is safe and feels quicker.
VOICE_SILENCE_MS=650
# RMS amplitude above which a frame counts as speech.
VOICE_SPEECH_RMS=800
# Ignore mic input for this long after the agent starts talking, so imperfect
# echo cancellation doesn't make it interrupt itself.
VOICE_BARGEIN_GRACE_MS=500
# Consecutive loud frames (~20ms each) needed to count as a real interruption.
VOICE_BARGEIN_MIN_FRAMES=5
VOICE_BARGEIN_RMS=1100
